+function resourceBacklogForCandidates(
+  candidates: readonly AdmissionPolicyContext["candidates"][number][],
+  taskById: ReadonlyMap<string, SchedulerGraphSnapshot["tasks"][number]>
+): ReadonlyMap<string, number> {
+  const backlog = new Map<string, number>();
+  for (const candidate of candidates) {
+    const task = taskById.get(candidate.taskId);
+    if (task === undefined) throw new Error("learned candidate is missing from graph");
+    for (const claim of task.resourceClaims) {
+      backlog.set(claim.resourceId, (backlog.get(claim.resourceId) ?? 0) + claim.units);
+    }
+  }
+  return backlog;
+}
+
+function resourceBacklogScore(
+  task: SchedulerGraphSnapshot["tasks"][number],
+  resourceBacklog: ReadonlyMap<string, number>
+): number {
+  return task.resourceClaims.reduce(
+    (score, claim) => score + claim.units * (resourceBacklog.get(claim.resourceId) ?? 0),
+    0
+  );
+}
