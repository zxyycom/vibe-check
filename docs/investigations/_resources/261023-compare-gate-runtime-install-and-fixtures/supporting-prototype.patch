+import { copyFileSync, existsSync, mkdirSync, symlinkSync, writeFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { dirname, join } from "node:path";
+import { pathToFileURL } from "node:url";
+
+// Experiment only: copies actual modules without source rewrites, mocks or production seams.
+const OWNER_MODULE_PATHS = [
+  "scripts/docs/package-api/example-projections.ts",
+  "scripts/docs/package-api/gate-guide-example-projections.ts",
+  "scripts/docs/package-documents.ts",
+  "scripts/error-message.ts",
+  "scripts/package/artifact/compiler-cache.ts",
+  "scripts/package/artifact/fingerprint.test-support.ts",
+  "scripts/package/artifact/fingerprint.ts",
+  "scripts/package/artifact/manifest.ts",
+  "scripts/package/compiler-toolchain.ts",
+  "scripts/package/file-inventory.ts",
+  "scripts/package/legal-materials/packaged-audit.ts",
+  "scripts/package/legal-materials/provenance-inventory.ts",
+  "scripts/package/legal-materials.ts",
+  "scripts/package/pack.ts",
+  "scripts/package/package-contract.ts",
+  "scripts/package/package-material-audit.ts",
+  "scripts/package/public-api-inventory.ts",
+  "scripts/process-execution/contract.ts",
+  "scripts/process-execution/execution.ts",
+  "scripts/process-execution/failure.ts",
+  "scripts/process-execution/plain-text-environment.ts",
+  "scripts/process-execution/result.ts",
+  "scripts/process-execution/runner.ts",
+  "scripts/repository-files/paths.ts",
+  "scripts/value-guards.ts"
+] as const;
+
+export async function createFixtureOwners(repositoryRoot: string, ownerRoot: string) {
+  for (const relativePath of OWNER_MODULE_PATHS) {
+    const destination = join(ownerRoot, relativePath);
+    mkdirSync(dirname(destination), { recursive: true });
+    copyFileSync(join(repositoryRoot, relativePath), destination);
+  }
+  const native = "node_modules/@typescript/native";
+  const compatibility = "node_modules/typescript";
+  const api = `${compatibility}/node_modules/@typescript/old`;
+  const platformName = `@typescript/typescript-${process.platform}-${process.arch}`;
+  const platform = `${native}/node_modules/${platformName}`;
+  // Only resolution, identity checks and hashing consume these bytes. No fixture bin executes.
+  const toolchainMaterials = {
+    [`${native}/package.json`]: JSON.stringify({ name: "typescript", version: "7.0.2", bin: { tsc: "bin/tsc.js" }, optionalDependencies: { [platformName]: "7.0.2" } }),
+    [`${native}/bin/tsc.js`]: "// fixture native bin\n",
+    [`${native}/lib/tsc.js`]: "// fixture native runner\n",
+    [`${native}/lib/getExePath.js`]: "// fixture platform resolver\n",
+    [`${platform}/package.json`]: JSON.stringify({ name: platformName, version: "7.0.2" }),
+    [`${platform}/lib/${process.platform === "win32" ? "tsc.exe" : "tsc"}`]: "fixture native executable bytes\n",
+    [`${compatibility}/package.json`]: JSON.stringify({ name: "@typescript/typescript6", version: "6.0.2", main: "lib/typescript.js" }),
+    [`${compatibility}/lib/typescript.js`]: "// fixture compatibility API\n",
+    [`${compatibility}/lib/typescript.d.ts`]: "// fixture compatibility declarations\n",
+    [`${api}/package.json`]: JSON.stringify({ name: "typescript", version: "6.0.3", main: "lib/typescript.js" }),
+    [`${api}/lib/typescript.js`]: "// fixture actual API implementation\n",
+    [`${api}/lib/typescript.d.ts`]: "// fixture actual API declarations\n"
+  };
+  for (const [path, bytes] of Object.entries(toolchainMaterials)) writeFixtureFile(ownerRoot, path, bytes);
+  // Preserve the real process runner dependency; no process execution is mocked or invoked.
+  symlinkSync(dirname(createRequire(import.meta.url).resolve("execa")), join(ownerRoot, "node_modules/execa"), "dir");
+  writeFixtureFile(ownerRoot, "node_modules/@types/node/package.json", JSON.stringify({ name: "@types/node", version: "24.0.0" }));
+  const fingerprint = await import(pathToFileURL(join(ownerRoot, "scripts/package/artifact/fingerprint.ts")).href);
+  const compiler = await import(pathToFileURL(join(ownerRoot, "scripts/package/artifact/compiler-cache.ts")).href);
+  const support = await import(pathToFileURL(join(ownerRoot, "scripts/package/artifact/fingerprint.test-support.ts")).href);
+  return { ...fingerprint, ...compiler, ...support, toolchainPaths: Object.keys(toolchainMaterials).map((path) => join(ownerRoot, path)) };
+}
+
+export function writeMinimalFingerprintRepository(root: string, collectInputs: (root: string) => readonly string[]) {
+  writeFixtureFile(root, "docs/package-documents.json", JSON.stringify({
+    markdownDocuments: [{ id: "readme", sourcePath: "README.md", packagePath: "README.md" }],
+    checkGuides: [{ checkId: "fixture", exportName: "fixture", sourcePath: "docs/guides/fixture.md", packagePath: "docs/guides/fixture.md" }],
+    machineMaterials: [{ sourcePath: "docs/schemas/fixture.json", packagePath: "docs/schemas/fixture.json" }]
+  }));
+  for (const path of ["src/index.ts", "src/package-checks/function-metrics/analyzer-worker.ts", "src/package-checks/markdown-link-validation/io-worker.ts", "scripts/package/artifact/build.ts", "docs/examples/package-api/example.ts"]) {
+    writeFixtureFile(root, path, `// fingerprint input ${path}\n`);
+  }
+  // Setup follows mandatory discovery; assertions independently name sensitivity obligations.
+  for (const path of collectInputs(root)) {
+    if (!existsSync(path)) {
+      mkdirSync(dirname(path), { recursive: true });
+      writeFileSync(path, `fingerprint fixture ${path.slice(root.length + 1)}\n`);
+    }
+  }
+}
+
+export function writeFixtureFile(root: string, path: string, bytes: string) {
+  const destination = join(root, path);
+  mkdirSync(dirname(destination), { recursive: true });
+  writeFileSync(destination, bytes);
+}
