diff --git a/lizard_languages/python.py b/lizard_languages/python.py
index 1269476..176a195 100644
--- a/lizard_languages/python.py
+++ b/lizard_languages/python.py
@@ -362 +362,6 @@ class PythonStates(CodeStateMachine):  # pylint: disable=R0903
-        if token != '(':
+        if token == '[':
+            # PEP 695 `def f[T](...)`. Do not restart on each token, or ']'
+            # becomes the name. Defer '(' so [T] appears in long_name.
+            self.br_count = 0
+            self.next(self._state_type_parameters, token)
+        elif token != '(':
@@ -364 +368,0 @@ class PythonStates(CodeStateMachine):  # pylint: disable=R0903
-            self.context.add_to_long_function_name("(")
@@ -365,0 +370 @@ class PythonStates(CodeStateMachine):  # pylint: disable=R0903
+            self.context.add_to_long_function_name("(")
@@ -367,0 +373,15 @@ class PythonStates(CodeStateMachine):  # pylint: disable=R0903
+    def _state_type_parameters(self, token):
+        # Consume a type param list, tracking nesting so bounds like
+        # `def f[T: list[int]](x)` work.
+        if token in ('def', 'class'):
+            # Unbalanced '[': truncated or invalid source. Neither keyword can
+            # appear inside a type param list, so treat this as the next
+            # definition instead of swallowing the rest of the file.
+            self.br_count = 0
+            self.next(self._state_global, token)
+            return
+        self.context.add_to_long_function_name(" " + token)
+        self.br_count += {'[': 1, ']': -1}.get(token, 0)
+        if self.br_count == 0:
+            self._state = self._function
+
diff --git a/lizard_languages/rust.py b/lizard_languages/rust.py
index 19f4cef..7b22837 100644
--- a/lizard_languages/rust.py
+++ b/lizard_languages/rust.py
@@ -17 +17 @@ class RustReader(CodeReader, CCppCommentsMixin):
-    _control_flow_keywords = {'if', 'for', 'while', 'catch', 'match', 'where'}
+    _control_flow_keywords = {'if', 'for', 'while', 'catch', 'where'}
@@ -19 +19 @@ class RustReader(CodeReader, CCppCommentsMixin):
-    _case_keywords = set()  # Rust uses match arms, not case keyword
+    _case_keywords = set()  # Rust match arms are counted via `=>` in RustStates
@@ -34,0 +35,36 @@ class RustStates(GoLikeStates):  # pylint: disable=R0903
+
+    def __init__(self, context, in_match_arms=False):
+        super().__init__(context)
+        self._in_match_arms = in_match_arms
+        self._seen_match_arm = False
+        self._match_subject_nesting = 0
+
+    def _state_global(self, token):
+        if token == '=>':
+            if self._in_match_arms:
+                if self._seen_match_arm:
+                    self.context.add_condition()
+                self._seen_match_arm = True
+            return
+        if token == 'match':
+            self._match_subject_nesting = 0
+            self._state = self._match_subject
+            return
+        super()._state_global(token)
+
+    def _match_subject(self, token):
+        if token in '([':
+            self._match_subject_nesting += 1
+            return
+        if token in ')]':
+            if self._match_subject_nesting:
+                self._match_subject_nesting -= 1
+            return
+        if token != '{' or self._match_subject_nesting:
+            return
+        self.sub_state(
+            RustStates(self.context, in_match_arms=True),
+            self._end_match)
+
+    def _end_match(self):
+        self.next(self._state_global)
