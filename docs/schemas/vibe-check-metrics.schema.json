                    "description": "Stable measurement capability identifier.",
                    "type": "string"
                  },
                  "diagnostic": {
                    "type": "object",
                    "required": [
                      "action",
                      "kind",
                      "message"
                    ],
                    "properties": {
                      "action": {
                        "type": "string",
