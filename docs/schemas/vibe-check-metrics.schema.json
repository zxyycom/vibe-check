                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "capabilityId",
                  "diagnostic",
                  "status"
                ],
                "properties": {
                  "capabilityId": {
                    "enum": [
                      "file-metrics",
                      "function-metrics",
                      "duplicate-detection"
