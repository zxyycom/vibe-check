                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "capabilityId",
                  "status"
                ],
                "properties": {
                  "capabilityId": {
                    "enum": [
                      "file-metrics",
                      "function-metrics",
                      "duplicate-detection"
