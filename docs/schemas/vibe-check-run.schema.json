            "pattern": "^check-record/v1/record/sha256:[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "catalogFingerprint": {
      "type": "string",
      "pattern": "^check-record/v1/catalog/sha256:[a-f0-9]{64}$"
    },
    "checks": {
