{
  "type": "object",
  "required": [
    "checks",
    "invocation",
    "recordsFingerprint",
    "schemaVersion"
  ],
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "checkId",
          "displayName",
          "outcome"
        ],
        "properties": {
          "checkId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "data",
                  "status"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {}
                    }
                  },
                  "status": {
                    "type": "string",
                    "const": "passed"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "data",
                  "status"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {}
                    }
                  },
                  "status": {
                    "type": "string",
                    "const": "failed"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "reason": {
                    "type": "object",
                    "required": [
                      "code"
                    ],
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "status": {
                    "type": "string",
                    "const": "not-applicable"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "reason",
                  "status"
                ],
                "properties": {
                  "reason": {
                    "type": "object",
                    "required": [
                      "code"
                    ],
                    "properties": {
                      "checkIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                        },
                        "minItems": 1
                      },
                      "code": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "status": {
                    "type": "string",
                    "const": "unavailable"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "invocation": {
      "type": "object",
      "required": [
        "invocationId",
        "projectRoot",
        "timestamp"
      ],
      "properties": {
        "invocationId": {
          "type": "string",
          "minLength": 1
        },
        "projectRoot": {
          "type": "string",
          "const": "."
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      },
      "additionalProperties": false
    },
    "recordsFingerprint": {
      "type": "string",
      "pattern": "^check-record/v2/records/sha256:[a-f0-9]{64}$"
    },
    "schemaVersion": {
      "type": "string",
      "const": "vibe-check.run.v4"
    }
  },
  "$id": "urn:vibe-check:schema:run:v4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Vibe Check machine run v4"
}
