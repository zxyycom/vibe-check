          "acceptanceId",
          "reason",
          "recordId"
        ],
        "properties": {
          "acceptanceId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
