{
  "name": "vibe-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "env:check": "bun scripts/environment/manage.ts check",
    "env:setup": "bun scripts/environment/manage.ts setup",
    "format": "bun scripts/development/format.ts",
    "lint": "bun scripts/development/lint.ts",
    "typecheck": "bun scripts/development/typecheck.ts",
    "test": "bun scripts/development/test.ts",
    "decisions": "bun scripts/decision-records/command.ts",
    "change-plan": "bun .codex/skills/change-plan/scripts/change-plan.mjs",
    "investigations": "bun .codex/skills/investigation-report/scripts/check-investigations.mjs --root .",
    "test-evidence": "bun scripts/test-evidence/command.ts",
    "validate": "bun scripts/validation/workspace.ts",
    "verify:vibe-check-workspace": "mise exec -- bun scripts/project/gate/run.ts",
    "verify:vibe-check-workspace:required": "mise exec -- bun scripts/project/gate/run.ts --profile required",
    "verify:vibe-check-workspace:full": "mise exec -- bun scripts/project/gate/run.ts --profile full",
    "package:status": "bun scripts/package/command.ts status",
    "package:build": "bun scripts/package/command.ts build",
    "package:verify": "bun scripts/package/command.ts verify",
    "package:release:prepare": "bun scripts/package/release/command.ts prepare",
    "package:release:verify": "bun scripts/package/release/command.ts verify",
    "maintenance:lizard-upstream": "bun scripts/maintenance/lizard-upstream-advisory.ts"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.0",
    "@types/node": "^24.13.2",
    "@typescript/native-preview": "7.0.0-dev.20260621.1",
    "csv-parse": "^7.0.0",
    "execa": "^9.6.1",
    "jiti": "^2.7.0",
    "jscpd": "5.1.1",
    "minimatch": "^10.2.5",
    "mnemonist": "0.40.4",
    "neverthrow": "8.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "remeda": "2.39.0",
    "ts-pattern": "5.9.0",
    "typebox": "^1.3.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@humanwhocodes/momoa": "3.3.12",
    "@secretlint/core": "13.0.5",
    "@secretlint/secretlint-rule-privatekey": "13.0.5",
    "ajv": "8.20.0",
    "github-slugger": "2.0.0",
    "immutable": "5.1.9",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0"
  }
}
