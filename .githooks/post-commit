#!/bin/sh

AUTO_PUSH_BRANCH="main"
AUTO_PUSH_REMOTE="origin"
AUTO_PUSH_INTERVAL_SECONDS=3600
STATE_DIRECTORY_NAME="vibe-check-hooks"
STATE_FILE_NAME="main-auto-push.last-at"

print_context() {
  printf '%s\n' "vibe-check post-commit auto-push"
  printf '  commit: %s\n' "$current_commit"
  printf '  branch: %s\n' "$display_branch"
  printf '  target: %s/%s\n' "$AUTO_PUSH_REMOTE" "$AUTO_PUSH_BRANCH"
}

print_skip() {
  printf '%s\n' "  action: skipped"
  printf '  reason: %s\n' "$1"
}

current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
current_commit="$(git rev-parse --short=12 HEAD 2>/dev/null || true)"
if [ -z "$current_commit" ]; then
  current_commit="unknown"
fi

display_branch="$current_branch"
if [ -z "$display_branch" ]; then
  display_branch="<detached>"
fi

print_context

if [ "$current_branch" != "$AUTO_PUSH_BRANCH" ]; then
  print_skip "only branch '$AUTO_PUSH_BRANCH' is eligible; no push was attempted."
  exit 0
fi

if ! git remote get-url "$AUTO_PUSH_REMOTE" >/dev/null 2>&1; then
  print_skip "remote '$AUTO_PUSH_REMOTE' is unavailable; no push was attempted."
  exit 0
fi

state_directory="$(git rev-parse --git-path "$STATE_DIRECTORY_NAME" 2>/dev/null || true)"
if [ -z "$state_directory" ] || ! mkdir -p "$state_directory"; then
  print_skip "the Git-local state directory is unavailable; no push was attempted."
  exit 0
fi

current_epoch_seconds="$(date +%s 2>/dev/null || true)"
case "$current_epoch_seconds" in
  '' | *[!0-9]*)
    print_skip "the current time is unavailable; no push was attempted."
    exit 0
    ;;
esac

state_file="$state_directory/$STATE_FILE_NAME"
last_attempt_epoch_seconds=0
if [ -r "$state_file" ]; then
  IFS= read -r stored_epoch_seconds <"$state_file" || stored_epoch_seconds=""
  case "$stored_epoch_seconds" in
    '' | *[!0-9]*) ;;
    *) last_attempt_epoch_seconds="$stored_epoch_seconds" ;;
  esac
fi

next_attempt_epoch_seconds=$((last_attempt_epoch_seconds + AUTO_PUSH_INTERVAL_SECONDS))
if [ "$current_epoch_seconds" -lt "$next_attempt_epoch_seconds" ]; then
  remaining_seconds=$((next_attempt_epoch_seconds - current_epoch_seconds))
  print_skip "cooldown has ${remaining_seconds}s remaining; no push was attempted."
  exit 0
fi

# Persist before invoking Git so failed pushes also consume the cooldown window.
temporary_state_file="$state_file.tmp.$$"
if ! (umask 077 && printf '%s\n' "$current_epoch_seconds" >"$temporary_state_file") || \
  ! mv "$temporary_state_file" "$state_file"; then
  rm -f "$temporary_state_file"
  print_skip "the attempt time could not be recorded safely; no push was attempted."
  exit 0
fi

printf '%s\n' "  action: push (non-force, no tags)"

if GIT_TERMINAL_PROMPT=0 git push \
  --porcelain \
  --no-force \
  --no-follow-tags \
  "$AUTO_PUSH_REMOTE" \
  "refs/heads/$AUTO_PUSH_BRANCH:refs/heads/$AUTO_PUSH_BRANCH"; then
  printf '%s\n' "  result: success; '$AUTO_PUSH_REMOTE/$AUTO_PUSH_BRANCH' contains commit '$current_commit'."
else
  printf '%s\n' "  result: failed; commit '$current_commit' remains local." >&2
  printf '%s\n' \
    "  next: no hook retry before cooldown expiry; no pull, rebase, or force was attempted." >&2
fi

exit 0
