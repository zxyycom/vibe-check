# Docnav helper commands for navigating repository Markdown docs.
prefix_rule(pattern=["docnav", "--help"], decision="allow")
prefix_rule(pattern=["docnav", "help"], decision="allow")
prefix_rule(pattern=["docnav", "outline"], decision="allow")
prefix_rule(pattern=["docnav", "read"], decision="allow")

# Bun runtime inspection and generic local test entrypoint.
prefix_rule(pattern=["bun", "-v"], decision="allow")
prefix_rule(pattern=["bun", "--version"], decision="allow")
prefix_rule(pattern=["bun", "test"], decision="allow")

# Vibe Check-owned direct script entrypoints.
prefix_rule(pattern=["bun", "scripts/docs/validate.ts"], decision="allow")
prefix_rule(pattern=["bun", "scripts/vibe-check-workspace/verify.ts"], decision="allow")
prefix_rule(pattern=["bun", "scripts/quality/scan.ts"], decision="allow")
prefix_rule(pattern=["bun", "scripts/quality/annotate.ts"], decision="prompt")
prefix_rule(pattern=["bun", "scripts/decision-records.ts"], decision="prompt")

# Decision record queries/checks are read-only; the generic entry can mutate lifecycle state.
prefix_rule(pattern=["bun", "run", "decisions:list"], decision="allow")
prefix_rule(pattern=["bun", "run", "decisions:check"], decision="allow")
prefix_rule(pattern=["bun", "run", "decisions"], decision="prompt")

# Change Plan discovery and target inspection are read-only; lifecycle commands can mutate metadata or move directories.
prefix_rule(pattern=["bun", "run", "change-plan:list"], decision="allow")
prefix_rule(pattern=["bun", "run", "change-plan", "--", "show"], decision="allow")
prefix_rule(pattern=["bun", "run", "change-plan", "--", "check"], decision="allow")
prefix_rule(pattern=["bun", "run", "change-plan"], decision="prompt")

# Investigation queries/checks are read-only; sync-index and stage-index write workspace or pending state.
prefix_rule(pattern=["bun", "run", "investigations:list"], decision="allow")
prefix_rule(pattern=["bun", "run", "investigations:check"], decision="allow")
prefix_rule(pattern=["bun", "run", "investigations"], decision="prompt")

# TypeScript product and script checks.
prefix_rule(pattern=["bun", "run", "lint:product"], decision="allow")
prefix_rule(pattern=["bun", "run", "typecheck:product"], decision="allow")
prefix_rule(pattern=["bun", "run", "test:product"], decision="allow")
prefix_rule(pattern=["bun", "run", "lint:scripts"], decision="allow")
prefix_rule(pattern=["bun", "run", "typecheck:scripts"], decision="allow")
prefix_rule(pattern=["bun", "run", "typecheck:scripts:tsc"], decision="allow")

# Workspace validation and verification.
prefix_rule(pattern=["bun", "run", "validate"], decision="allow")
prefix_rule(pattern=["bun", "run", "validate:docs"], decision="allow")
prefix_rule(pattern=["bun", "run", "validate:diff"], decision="allow")
prefix_rule(pattern=["bun", "run", "verify:vibe-check-workspace"], decision="allow")
prefix_rule(pattern=["bun", "run", "verify:vibe-check-workspace:required"], decision="allow")
prefix_rule(pattern=["bun", "run", "verify:vibe-check-workspace:full"], decision="allow")

# Non-blocking quality observation commands.
prefix_rule(pattern=["bun", "run", "quality:check"], decision="allow")
prefix_rule(pattern=["bun", "run", "quality:full-check"], decision="allow")
prefix_rule(pattern=["bun", "run", "quality:scan"], decision="allow")

# Opt-in blocking quality gate.
prefix_rule(pattern=["bun", "run", "quality:gate"], decision="allow")

# Quality annotation can emit GitHub workflow commands.
prefix_rule(pattern=["bun", "run", "quality:annotate"], decision="prompt")

# Shared script toolkit checks.
prefix_rule(pattern=["bun", "run", "toolkit:foundation:typecheck"], decision="allow")
prefix_rule(pattern=["bun", "run", "toolkit:foundation:lint"], decision="allow")
prefix_rule(pattern=["bun", "run", "toolkit:foundation:test"], decision="allow")
prefix_rule(pattern=["bun", "run", "toolkit:parallel:typecheck"], decision="allow")
prefix_rule(pattern=["bun", "run", "toolkit:parallel:lint"], decision="allow")
prefix_rule(pattern=["bun", "run", "toolkit:parallel:test"], decision="allow")

# Package, dependency, and ad-hoc Bun commands can change workspace state.
prefix_rule(pattern=["bun", "install"], decision="prompt")
prefix_rule(pattern=["bun", "add"], decision="prompt")
prefix_rule(pattern=["bun", "remove"], decision="prompt")
prefix_rule(pattern=["bun", "update"], decision="prompt")
prefix_rule(pattern=["bun", "x"], decision="prompt")
prefix_rule(pattern=["bunx"], decision="prompt")
prefix_rule(pattern=["pnpm", "install"], decision="prompt")
prefix_rule(pattern=["pnpm", "add"], decision="prompt")
prefix_rule(pattern=["pnpm", "remove"], decision="prompt")
prefix_rule(pattern=["pnpm", "update"], decision="prompt")
prefix_rule(pattern=["pnpm", "exec"], decision="prompt")
prefix_rule(pattern=["pnpm", "dlx"], decision="prompt")
