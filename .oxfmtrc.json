{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "sortImports": false,
  "sortPackageJson": false,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false
}
